# Site paths. Edit this file, and nothing else, to run the analysis somewhere new.
#
# The hpc/ wrappers source it and scripts/site_paths.py reads it, so both sides see the same
# values. Keep the format to plain KEY=value lines; quote values that contain spaces.
#
# The project root is not set here. Python scripts find it from their own location. Slurm
# copies each wrapper to a spool directory before running it, so a wrapper cannot find this
# file from its own path; each one carries the cluster project root as a default that the
# IL15_ROOT environment variable overrides.

# Fiji launcher on the cluster (ImageJ 1.54p, Bio-Formats, Colour Deconvolution2 — environment/README.md)
FIJI=/pub/evaz/fiji/Fiji.app/ImageJ-linux64

# The lab share as the cluster sees it, and as the workstation mounts it. imagelist.txt holds
# cluster paths; workstation scripts swap the first prefix for the second.
HPC_SHARE=/share/crsp/lab/dalawson/share
LOCAL_SHARE="/Users/Eva/Library/Application Support/CRSP Desktop/Volumes.noindex/CRSP Lab - Lawson Lab.localized/share"
